# --- Переменные для Vercel (Settings → Environment Variables) ---

# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token

# ID группы (отрицательное число, например -1001234567890)
GROUP_ID=-1001234567890

# ID темы «Ошибки» (message_thread_id)
BUGS_THREAD_ID=2

# ID темы «Функционал» (необязательно, если нет — функция выключена)
FEATURES_THREAD_ID=

# ID темы «Результат дня» (в 18:00 сюда уходит, что сделано за день); если пусто — тема сводки
RESULT_THREAD_ID=

# ID темы «Протестировано» (сюда попадают баги и функционал со статусом «Протестировал»)
TESTED_THREAD_ID=

# ID темы для сводки; если пусто, сводка идёт в тему с багами
REPORT_THREAD_ID=

# Строка подключения Neon (Postgres), с ?sslmode=require
DATABASE_URL=postgres://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Случайная строка: проверяет, что запросы идут от Telegram
WEBHOOK_SECRET=придумайте-длинную-строку

# Случайная строка: защищает сводку от посторонних вызовов.
# Vercel Cron отправит её сам, если переменная задана
CRON_SECRET=придумайте-вторую-длинную-строку

# Часовой пояс
TZ_NAME=Asia/Almaty
